rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // helper: 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /resources/{resourceId} {
      allow read, write: if isAuthenticated();
    }

    match /reservations/{resId} {
      allow read: if isAuthenticated();
      
      // CREATE: Must not exist and authenticated
      allow create: if isAuthenticated() && resource == null;

      // UPDATE: Strictly restrict updates to the original creator's reservation (owner & ownerId cannot be modified or hijacked)
      allow update: if isAuthenticated() && 
                    resource.data.owner == request.resource.data.owner &&
                    (!('ownerId' in resource.data) || resource.data.ownerId == request.resource.data.ownerId);

      // DELETE: Deny all deletes (must update status to cancelled instead)
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /announcements/{annId} {
      allow read, write: if isAuthenticated();
    }
  }
}
