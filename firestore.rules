rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // helper: 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /resources/{resourceId} {
      allow read, write: if isAuthenticated();
    }

    match /reservations/{resId} {
      allow read: if isAuthenticated();
      
      // CREATE: Must not exist and authenticated
      allow create: if isAuthenticated() && resource == null;

      // UPDATE: Only allow if the owner is not being changed.
      allow update: if isAuthenticated() && 
                    (request.resource.data.ownerId == resource.data.ownerId || 
                     request.resource.data.owner == resource.data.owner);

      // DELETE: Deny all deletes (must update status to cancelled instead)
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /announcements/{annId} {
      allow read, write: if isAuthenticated();
    }
  }
}
